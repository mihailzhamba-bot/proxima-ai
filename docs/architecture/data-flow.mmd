flowchart TB
  subgraph S[Sources]
    XLSX[Official WB XLSX]
    API[Official WB READ APIs]
    TS[Torgstat supporting absent in M1]
  end

  subgraph E[Immutable evidence]
    RAW[(Raw bytes by SHA-256)]
    MAN[Manifest]
    ATT[Acquisition attempt]
  end

  subgraph Q[Data quality]
    PARSE[Parser plus schema version]
    STAGE[(Tenant staging)]
    QUAR[(Quarantine)]
    CHECK[Quality and reconciliation]
  end

  subgraph R[Atomic releases]
    OP[(Operational)]
    INV[(Inventory)]
    FIN[(Financial)]
    LKG[Last-known-good pointers]
  end

  UI[Read-only Data Health]
  SIGNAL[Staging exception: margin and stockout calculation]
  TG[One manual Telegram alert]
  PREVIEW[Localhost preview: unreleased daily order_count]

  XLSX -->|hash before parse| RAW
  API -->|gzip JSON then hash| RAW
  TS -. supporting_absent .-> CHECK
  RAW --> MAN --> ATT --> PARSE --> STAGE --> CHECK
  PARSE -->|schema drift or invalid row| QUAR
  CHECK -->|pass operational| OP
  CHECK -->|pass inventory| INV
  CHECK -->|pass financial| FIN
  CHECK -->|fail partial stale conflict| QUAR
  OP --> LKG
  INV --> LKG
  FIN --> LKG
  LKG --> UI
  ATT --> UI
  MAN --> UI
  QUAR --> UI
  API -->|exact response bytes before parse| SIGNAL
  SIGNAL -->|one deterministic top risk| TG
  API -->|daily detail report, transaction-bounded transform| PREVIEW
  PREVIEW -.->|lineage to artifact SHA-256, preview-only, no release pointer| CHECK
