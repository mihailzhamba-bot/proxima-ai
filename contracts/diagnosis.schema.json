{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxima.local/contracts/diagnosis/v1",
  "title": "DiagnosisV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "primary_cause", "alternatives", "unknowns", "source_refs", "confidence_note", "reviewer"],
  "properties": {
    "schema_version": { "const": 1 },
    "signal_id": { "type": "string", "minLength": 1 },
    "primary_cause": { "type": "string", "minLength": 1 },
    "alternatives": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
    "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Positional: exactly 1 + len(alternatives) + len(unknowns) entries - first for the primary cause, then one per alternative, then one per unknown. Enforced by tools/verify_contracts.py and services/collector/tests/product-contracts.test.ts (not expressible in JSON Schema alone)."
    },
    "confidence_note": { "type": "string", "minLength": 1 },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "model"],
      "properties": {
        "verdict": { "enum": ["pass", "block"] },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
