{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxima.local/contracts/cabinet-daily/v1",
  "title": "CabinetDailyV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "day", "orders", "revenue", "source_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "day": { "type": "string", "format": "date" },
    "orders": { "type": "integer", "minimum": 0 },
    "revenue": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
