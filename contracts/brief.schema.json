{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxima.local/contracts/brief/v1",
  "title": "BriefV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data_status", "evaluation_day", "actual", "norm", "deviation_pct", "signals", "source_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "data_status": { "$ref": "#/$defs/dataStatus" },
    "evaluation_day": { "type": "string", "format": "date" },
    "actual": { "$ref": "#/$defs/actual" },
    "norm": { "$ref": "#/$defs/norm" },
    "deviation_pct": { "$ref": "#/$defs/deviationPct" },
    "signals": { "type": "array", "items": { "$ref": "https://proxima.local/contracts/signal/v1" } },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "dataStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_full_day", "collected_at", "stale"],
      "properties": {
        "last_full_day": { "type": "string", "format": "date" },
        "collected_at": { "type": ["string", "null"], "format": "date-time" },
        "stale": { "type": "boolean" }
      }
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orders", "revenue"],
      "properties": {
        "orders": { "type": "integer", "minimum": 0 },
        "revenue": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" }
      }
    },
    "norm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orders", "revenue", "window_days", "sample_days"],
      "properties": {
        "orders": { "type": "number", "minimum": 0 },
        "revenue": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
        "window_days": { "type": "integer", "minimum": 1 },
        "sample_days": { "type": "integer", "minimum": 0 }
      }
    },
    "deviationPct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orders", "revenue"],
      "properties": {
        "orders": { "type": "number" },
        "revenue": { "type": "number" }
      }
    }
  }
}
