{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://proxima.local/contracts/loop-task/v1",
  "title": "LoopTaskV1",
  "required": [
    "schema_version",
    "task_id",
    "tenant_id",
    "decision_id",
    "run_id",
    "assignee_id",
    "action",
    "due_at",
    "expected_outcome",
    "horizon_days",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "assignee_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_outcome": {
      "type": "string",
      "minLength": 1
    },
    "horizon_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
