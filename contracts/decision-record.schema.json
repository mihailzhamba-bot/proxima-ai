{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxima.local/contracts/decision-record/v1",
  "title": "DecisionRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "decision", "actor", "decided_at", "reason", "expected", "actual", "delta"],
  "properties": {
    "schema_version": { "const": 1 },
    "signal_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["accepted", "rejected"] },
    "actor": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "expected": { "$ref": "#/$defs/measurement" },
    "actual": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/measurement" }] },
    "delta": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/measurement" }] },
    "outcome": { "enum": ["confirmed", "refuted", "partial", "unknown"] }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "source_ref"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+\\.[0-9]{2}$",
          "description": "Money as a string with exactly two decimal places (AD-10)."
        },
        "unit": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "horizon_days"],
      "properties": {
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
        "horizon_days": { "type": "integer", "exclusiveMinimum": 0 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "decision": { "const": "rejected" } } }, "then": { "properties": { "reason": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "actual": { "type": "null" } } }, "then": { "not": { "required": ["outcome"] } } },
    { "if": { "properties": { "actual": { "type": "object" } } }, "then": { "required": ["outcome"] } }
  ]
}
