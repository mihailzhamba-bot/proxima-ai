{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proxima.local/contracts/signal/v1",
  "title": "SignalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "scenario_code", "snapshot_id", "tenant_id", "created_at", "trust_marking", "rub_assessment", "source_refs", "detection_data"],
  "properties": {
    "schema_version": { "const": 1 },
    "signal_id": { "type": "string", "minLength": 1 },
    "scenario_code": { "enum": ["SCN-001", "SCN-005", "SCN-008"] },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "trust_marking": { "enum": ["unreleased", "released"] },
    "rub_assessment": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value_rub", "method"],
          "properties": {
            "value_rub": { "type": "number" },
            "method": { "enum": ["revenue", "profit"] }
          }
        }
      ]
    },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "detection_data": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "is_unknown"],
        "properties": {
          "value": { "type": ["number", "string", "boolean", "null"] },
          "is_unknown": { "type": "boolean" }
        },
        "allOf": [
          { "if": { "properties": { "is_unknown": { "const": true } } }, "then": { "properties": { "value": { "type": "null" } } } },
          { "if": { "properties": { "is_unknown": { "const": false } } }, "then": { "properties": { "value": { "not": { "type": "null" } } } } }
        ]
      }
    }
  }
}
