# Пример локального окружения. Копировать в .env, значения не коммитить.
# Правило проекта: значения токенов и паролей никуда не попадают - ни в этот файл, ни в лог,
# ни в отчёт. Здесь только имена переменных и пути к файлам секретов.
# Канон имён - таблица Conventions в ARCHITECTURE-SPINE.md; расхождения - docs/state/MIGRATION-GAPS.md §7.3.

# --- База данных (локально через туннель: ssh -N proxima-db) ---
DATABASE_URI=postgresql://<user>:<password>@localhost:5433/<db>
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=proxima
PROXIMA_POSTGRES_PORT=5433

# --- Тестовые подключения (заполняет tools/pg_local_roundtrip.sh, вручную не нужны) ---
# PROXIMA_TEST_DSN_COLLECTOR=
# PROXIMA_TEST_DSN_NORM=
# PROXIMA_TEST_DSN_WEBAPP=
# PROXIMA_TEST_DSN_JANITOR=
# PROXIMA_TEST_DSN_SANDBOX=

# --- Пути к секретам на сервере (локально обычно не нужны) ---
PROXIMA_SECRETS_DIR=/etc/proxima-ai/secrets
PROXIMA_RAW_DIR=/srv/proxima-ai/raw
COLLECTOR_DATABASE_URI_FILE=/run/secrets/proxima_collector_uri
NORM_DATABASE_URI_FILE=/run/secrets/proxima_norm_uri
JANITOR_DATABASE_URI_FILE=/run/secrets/proxima_janitor_uri

# --- Токены WB: только пути к файлам, никогда не значения ---
WB_STATISTICS_TOKEN_FILE=/etc/proxima-ai/secrets/wb_statistics_token
WB_ANALYTICS_TOKEN_FILE=/etc/proxima-ai/secrets/wb_analytics_token
WB_FINANCE_TOKEN_FILE=/etc/proxima-ai/secrets/wb_finance_token
# Тесты сеть не используют: WB_ALLOW_LIVE_NETWORK не включать.

# --- Веб-морда ---
WEBAPP_DATA_MODE=fixtures        # пусто или fixtures - демо-данные; postgres - только после первой сводки
WEBAPP_TENANT_ID=amirova-test
WEBAPP_REQUIRE_AUTH=false        # сентябрь: без авторизации, доступ через туннель
# WEBAPP_DATA_DATABASE_URI_FILE=/run/secrets/proxima_webapp_uri

# --- Сборка ---
PUPPETEER_SKIP_DOWNLOAD=1        # иначе npm ci тянет Chromium
# TMPDIR=/tmp                    # при длинном пути к проекту: TMPDIR=/tmp make verify
