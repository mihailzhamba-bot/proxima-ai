{
  "$schema": "https://opencode.ai/schema.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "postgres": {
      "type": "local",
      "command": ["uvx", "--python", "3.13", "--with", "mcp<2", "--from", "postgres-mcp", "postgres-mcp", "--access-mode=restricted"],
      "environment": {
        "DATABASE_URI": "${DATABASE_URI}"
      }
    }
  }
}
