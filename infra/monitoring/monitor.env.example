# Systemd reads this file before dropping privileges to proxima-monitor.
# The secret values themselves belong only in the two files below, never here.
PROXIMA_MONITOR_CONTRACT=/etc/proxima-ai/vps-contract.json
PROXIMA_MONITOR_STATE_FILE=/var/lib/proxima-ai-monitor/state.json
PROXIMA_TELEGRAM_TOKEN_FILE=/etc/proxima-ai/secrets/telegram_bot_token
PROXIMA_TELEGRAM_CHAT_ID_FILE=/etc/proxima-ai/secrets/telegram_chat_id
