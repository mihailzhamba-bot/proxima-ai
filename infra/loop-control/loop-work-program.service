[Unit]
Description=LOOP bounded GLM research work program
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /opt/loop/work_program.py --config /etc/loop/work-program.json run
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/loop/work-program.json /etc/loop/secrets/glm_program
ReadWritePaths=/var/lib/loop-work-program /srv/loop/work-program/results
MemoryMax=256M
CPUQuota=50%
TasksMax=32
TimeoutStartSec=150s
