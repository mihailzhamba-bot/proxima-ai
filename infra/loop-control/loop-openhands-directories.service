[Unit]
Description=Prepare isolated LOOP OpenHands and worker directories
Requires=loop-worker-volume.service
After=loop-worker-volume.service
Before=loop-openhands-agent-server.service

[Service]
Type=oneshot
SupplementaryGroups=loop-worker-shared
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-oh-agent -m 0700 /srv/loop-worker/agent-home
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-worker-shared -m 0750 /srv/loop-worker/agent-state
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-oh-agent -m 0700 /srv/loop-worker/agent-state/openhands
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-worker-shared -m 2750 /srv/loop-worker/agent-state/conversations
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-oh-agent -m 0700 /srv/loop-worker/agent-state/bash-events
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-oh-agent -m 0700 /srv/loop-worker/agent-state/tmp
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-oh-agent -m 0700 /srv/loop-worker/codex-home
ExecStart=/usr/bin/install -o root -g root -m 0444 /dev/null /srv/loop-worker/codex-home/config.toml
ExecStart=/usr/bin/install -d -o loop-worker-runner -g loop-worker-runner -m 0700 /srv/loop-worker/runner-state
ExecStart=/usr/bin/install -d -o loop-worker-runner -g loop-worker-runner -m 0700 /srv/loop-worker/runner-state/tmp
ExecStart=/usr/bin/install -d -o loop-worker-runner -g loop-worker-runner -m 0700 /srv/loop-worker/trusted-source
ExecStart=/usr/bin/install -d -o loop-bundle-collector -g loop-bundle-collector -m 0700 /srv/loop-worker/collector-home
ExecStart=/usr/bin/install -d -o loop-bundle-collector -g loop-bundle-collector -m 0700 /srv/loop-worker/collector-home/tmp
ExecStart=/usr/bin/install -d -o root -g root -m 0700 /srv/loop-worker/gateway
ExecStart=/usr/bin/install -d -o root -g root -m 0700 /srv/loop-worker/gateway/outbox
ExecStart=/usr/bin/install -d -o root -g root -m 0700 /srv/loop-worker/gateway/receipts
ExecStart=/usr/bin/install -d -o root -g root -m 0711 /srv/loop-worker/transfer
ExecStart=/usr/bin/install -d -o loop-worker-runner -g loop-worker-shared -m 2770 /srv/loop-worker/workspaces
ExecStart=/usr/bin/install -d -o loop-oh-agent -g loop-worker-shared -m 2770 /srv/loop-worker/worktrees
ExecStartPost=/usr/bin/python3 -I -c "import grp,os,stat; shared=grp.getgrnam('loop-worker-shared').gr_gid; expected={'/srv/loop-worker/agent-state/conversations':(shared,0o2750),'/srv/loop-worker/workspaces':(shared,0o2770),'/srv/loop-worker/worktrees':(shared,0o2770),'/srv/loop-worker/transfer':(0,0o711)}; assert all(os.stat(path).st_gid==gid and stat.S_IMODE(os.stat(path).st_mode)==mode for path,(gid,mode) in expected.items()); info=os.stat('/srv/loop-worker/codex-home/config.toml'); assert stat.S_IMODE(info.st_mode)==0o444 and info.st_uid==0"
RemainAfterExit=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib /srv
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
