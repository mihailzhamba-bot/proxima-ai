# Non-secret job parameters (AD-15). Values only, no secrets: owner credentials stay in
# /etc/proxima-ai/secrets/* mounted via compose `secrets:` as /run/secrets/<name>.
# Key allowlist is enforced by tools/wb_async_report.py:read_env_file().
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=proxima
POSTGRES_USER_FILE=/run/secrets/postgres_user
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
WB_ANALYTICS_TOKEN_FILE=/run/secrets/amirova-test_wb_analytics_token
PROXIMA_RAW_DIR=/srv/proxima-ai/raw
PROXIMA_SPOOL_DIR=/srv/proxima-ai/raw/wb-async-spool
# PROXIMA_SECRETS_DIR — задаётся на VPS при релизе, см. Conventions (источник файлов для compose `secrets:`).
# PROXIMA_RAW_DIR — задаётся на VPS при релизе, см. Conventions (корень сырых артефактов прогонов).
