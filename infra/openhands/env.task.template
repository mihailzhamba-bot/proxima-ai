# Copy to the repository root as .env.task inside the OpenHands sandbox.
# The URI value stays in the provisioned 0600 secret file and is never stored
# in this repository or echoed by the verification hook.
DATABASE_URI="$(tr -d '\r\n' < /etc/proxima-ai/secrets/proxima_sandbox_uri)"
PROXIMA_TENANT_ID=replace-with-provisioned-tenant-id
