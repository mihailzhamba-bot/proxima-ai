[Unit]
Description=PROXIMA AI morning jobs for tenant %i
Wants=network-online.target
After=network-online.target docker.service
OnFailure=proxima-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/proxima-ai/repo
ExecStart=/usr/bin/env bash /srv/proxima-ai/repo/tools/morning_run.sh %i
ProtectHome=true
