[Unit]
Description=PROXIMA AI morning jobs for tenant %i
Wants=network-online.target
After=network-online.target docker.service
OnFailure=proxima-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/proxima-ai/repo
EnvironmentFile=-/srv/proxima-ai/repo/infra/jobs.env
# Deadline carrier for 06:30 MSK (FR-22, D25 solution 4a / AD-6): the timer
# fires 05:30 MSK, so 55 min keeps the morning chain inside the deadline;
# overrun = unit failure = the same proxima-alert OnFailure path.
TimeoutStartSec=55min
ExecStart=/usr/bin/env bash /srv/proxima-ai/repo/tools/morning_run.sh %i
ProtectHome=true
