[Unit]
Description=PROXIMA AI weekly WB funnel CSV download and promotion for tenant %i
Wants=network-online.target
After=network-online.target docker.service proxima-morning@%i.service
OnFailure=proxima-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/proxima-ai/repo
EnvironmentFile=-/srv/proxima-ai/repo/infra/jobs.env
ExecStart=/usr/bin/env bash /srv/proxima-ai/repo/tools/funnel_csv_run.sh %i
ProtectHome=true
