#!/usr/bin/env bash
# complete-task <TASK-ID> — fail-closed gate for moving a task to DONE.
# Usage: scripts/agent/complete-task <TASK-ID> [--reviewer <name>] [--trivial]
# Behavior:
#   1. TASK-ID must exist in docs/agent-system/TASKS.md
#   2. runs scripts/agent/verify — non-zero exit blocks DONE
#   3. substantive tasks require --reviewer <name>; --trivial allowed for docs-only fixes
#   4. writes verification evidence to docs/agent-system/evidence/<TASK-ID>-<ts>.md
#   5. flips task Status -> DONE (with evidence reference) in TASKS.md
#   6. prints reminder to update HANDOFF.md
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"; cd "$ROOT"
TASK_ID="${1:-}"; REVIEWER=""; TRIVIAL=0
shift 2>/dev/null || true
while [ $# -gt 0 ]; do case "$1" in
  --reviewer) REVIEWER="${2:-}"; shift 2;;
  --trivial) TRIVIAL=1; shift;;
  *) echo "unknown arg: $1"; exit 2;;
esac; done
[ -n "$TASK_ID" ] && [ "${TASK_ID:0:2}" != "--" ] || { echo "usage: complete-task <TASK-ID> [--reviewer <name>] [--trivial]"; exit 2; }
TASKS="docs/agent-system/TASKS.md"
[ -f "$TASKS" ] || { echo "complete-task: $TASKS not found"; exit 1; }
grep -q "$TASK_ID" "$TASKS" || { echo "complete-task: task '$TASK_ID' not found in $TASKS"; exit 1; }

echo "==> [1/4] running full verify (fail closed)"
VERIFY_OUT="$(scripts/agent/verify 2>&1)"; VERIFY_RC=$?
echo "$VERIFY_OUT"
[ $VERIFY_RC -eq 0 ] || { echo "complete-task: VERIFY FAILED (exit $VERIFY_RC) — DONE not allowed. Fix, or set BLOCKED + reason."; exit 1; }

if [ $TRIVIAL -eq 0 ] && [ -z "$REVIEWER" ]; then
  echo "complete-task: substantive task requires review — pass --reviewer <name> (or --trivial for docs-only fix)."
  echo "Reviewer standard: _ai/templates/reviewer-agent.md (MILV) — independent, verdict format, 0 blockers gate."
  echo "Reviewer must be independent of the worker and check: acceptance criteria, regressions, edge cases, security, missing tests, doc drift."
  exit 1
fi

TS="$(date +%Y-%m-%dT%H:%M:%S%z)"; HEAD="$(git rev-parse HEAD 2>/dev/null || echo NO-GIT)"
FINGERPRINT="$(git status --porcelain 2>/dev/null | shasum -a 256 | cut -d' ' -f1)"
EVDIR="docs/agent-system/evidence"; mkdir -p "$EVDIR"
EV="$EVDIR/${TASK_ID}-$(date +%Y%m%d-%H%M%S).md"
CHECKS="$(echo "$VERIFY_OUT" | grep -E '^(==>|.*OK|.*FAIL|PASS|VERIFY)' | head -40)"

cat > "$EV" <<EOF
# Verification evidence — ${TASK_ID}

- Task ID: ${TASK_ID}
- Completed at: ${TS}
- Git HEAD: ${HEAD}
- Working tree fingerprint (porcelain sha256): ${FINGERPRINT}
- Verify command: scripts/agent/verify
- Exit code: 0
- Reviewer: ${REVIEWER:-trivial (docs-only), no independent review required}
- Reviewer status: ${REVIEWER:+performed}
- Generated by: scripts/agent/complete-task (fail-closed gate)

## Checks executed

\`\`\`
${CHECKS}
\`\`\`

## Policy

DONE is valid ONLY with this evidence generated in the same working state. A recorded PASS from an earlier session = STALE EVIDENCE and does not count (audit rule 2026-08-16).
EOF
echo "==> [2/4] evidence written: $EV"

echo "==> [3/4] updating $TASKS"
python3 - "$TASKS" "$TASK_ID" "$EV" <<'PY'
import re, sys, datetime
path, tid, ev = sys.argv[1], sys.argv[2], sys.argv[3]
body = open(path).read()
pat = re.compile(r'(^#{2,3}\s+' + re.escape(tid) + r'\b.*?Status:\s*)([A-Z_]+)', re.S | re.M)
new, n = pat.subn(lambda m: m.group(1) + 'DONE (evidence: ' + ev + ', ' + datetime.date.today().isoformat() + ')', body, count=1)
if n == 0:
    # fallback: task mentioned but no own Status line — annotate nearest status after the id
    new = re.sub(r'(\*\*' + re.escape(tid) + r'\*\*[^S]*Status:\s*)([A-Z_]+)',
                 lambda m: m.group(1) + 'DONE (evidence: ' + ev + ')', body, count=1)
    n = 1 if new != body else 0
if n == 0:
    print("complete-task: could not locate Status line for task — update TASKS.md manually"); sys.exit(1)
open(path, 'w').write(new)
PY
[ $? -eq 0 ] || exit 1

echo "==> [4/4] done. REMINDER: update docs/agent-system/HANDOFF.md (current state, exact next action, updated-at) now."
echo "complete-task: OK — $TASK_ID -> DONE with fresh evidence."
