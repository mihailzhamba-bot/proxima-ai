#!/usr/bin/env bash
# check-drift — documentation vs reality checks for this repo.
# Errors (exit 1): TASKS has Status: DONE without fresh evidence; HEAD-ref in docs points to non-current commit claimed as HEAD.
# Warnings (exit 0, printed): stale HANDOFF (>14 days while repo has newer commits); registry/TASKS next-action mismatch.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"; cd "$ROOT"
RC=0
TASKS="docs/agent-system/TASKS.md"; HANDOFF="docs/agent-system/HANDOFF.md"
[ -f "$TASKS" ] || { echo "check-drift: no TASKS.md (skip)"; exit 0; }

# 1) DONE tasks must have evidence (fail-closed audit rule)
python3 - "$TASKS" <<'PY' || RC=1
import re, sys, glob
tasks = open(sys.argv[1], encoding="utf-8", errors="replace").read()
errs = []
for m in re.finditer(r'^##\s+([A-Za-z0-9][A-Za-z0-9_-]*)\b', tasks, re.M):
    tid = m.group(1)
    if not re.match(r'^[A-Z][A-Z0-9]*[-_][A-Za-z0-9_-]*$', tid):
        continue  # not a task-ID header (e.g. "Active main task", "Queue", "Done")
    sect = tasks[m.end():tasks.find("\n## ", m.end()) if tasks.find("\n## ", m.end()) != -1 else None]
    st = re.search(r'Status:\s*(.+)', sect)
    if st and re.search(r'\bDONE\b', st.group(1)):
        if not glob.glob(f"docs/agent-system/evidence/*{tid}*"):
            errs.append(f"ERROR: task {tid} is DONE but no evidence file in docs/agent-system/evidence/")
for e in errs: print(e)
sys.exit(1 if errs else 0)
PY

# 2) HEAD-refs in docs claimed as current HEAD
HEAD="$(git rev-parse HEAD 2>/dev/null || true)"
if [ -n "$HEAD" ]; then
  for f in "$TASKS" "$HANDOFF"; do
    [ -f "$f" ] || continue
    while IFS= read -r ref; do
      case "$HEAD" in "$ref"*) ;; *) echo "ERROR: $f claims HEAD \`$ref\` but actual HEAD is ${HEAD:0:7} (stale doc or reword needed)"; RC=1;; esac
    done < <(grep -oE 'HEAD[^a-f0-9]{0,3}`?[0-9a-f]{7,40}`?' "$f" | grep -oE '[0-9a-f]{7,40}' | sort -u)
  done
fi

# 3) stale HANDOFF: Updated older than 14 days while commits are newer
if [ -f "$HANDOFF" ]; then
    upd=$(grep -oE '(Last updated|Updated at|updated):?[: ]*[0-9]{4}-[0-9]{2}-[0-9]{2}' "$HANDOFF" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -1)
  if [ -n "$upd" ]; then
    age_days=$(( ( $(date +%s) - $(date -j -f "%Y-%m-%d" "$upd" +%s 2>/dev/null || date +%s) ) / 86400 ))
    last_commit_days=$(( ( $(date +%s) - $(git log -1 --format=%ct 2>/dev/null || echo $(date +%s)) ) / 86400 ))
    if [ "$age_days" -gt 14 ] && [ "$last_commit_days" -lt "$age_days" ]; then
      echo "WARN: HANDOFF updated $upd (${age_days}d ago) but last commit is ${last_commit_days}d old — refresh HANDOFF"
    fi
  fi
fi

# 4) registry vs TASKS status-marker conflict (warning)
REG="$HOME/Desktop/MILV/_ai/registry/projects.json"
if [ -f "$REG" ] && command -v python3 >/dev/null; then
  MILV_ROOT="${MILV_ROOT:-$HOME/Desktop/MILV}"
  python3 - "$REG" "$TASKS" "$MILV_ROOT" <<'PY'
import json, re, sys, os
try: reg = json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
reg_root, cwd = sys.argv[3], os.getcwd()
body = open(sys.argv[2], encoding="utf-8", errors="replace").read()
for p in reg.get("projects", []):
    cp = p.get("canonical_path") or ""
    cp = os.path.expanduser(cp) if cp.startswith("~") else (os.path.join(reg_root, cp) if not cp.startswith("/") else cp)
    try: same = os.path.realpath(cp) == os.path.realpath(cwd)
    except Exception: same = False
    if same:
        na = (p.get("next_action") or "")
        m = re.search(r'\b(WAITING_FOR_USER|WAITING_FOR_EXTERNAL_SYNC|BLOCKED|UNKNOWN)\b', na)
        if m and m.group(1) not in body:
            print(f"WARN: registry says {m.group(1)} but TASKS.md lacks that marker — sync statuses")
        break
PY
fi

[ $RC -eq 0 ] && echo "check-drift: OK (no errors; warnings above if any)" || echo "check-drift: FAIL"
exit $RC
